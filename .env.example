# Production values. Copy this file to .env and fill every blank secret.
APP_PORT=8080
BIND_ADDRESS=127.0.0.1
APP_DOMAIN=

MONGO_ROOT_USERNAME=mis_admin
MONGO_ROOT_PASSWORD=
REDIS_PASSWORD=

# At least 32 random bytes; 64+ random characters are recommended.
JWT_SECRET=

# Exact public origins, comma separated. Example: https://mis.example.com
APP_CORS_ALLOWED_ORIGINS=

APP_BOOTSTRAP_ENABLED=true
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=

# Keep false on a real production system. Set true only for a classroom demo.
APP_DEMO_DATA_ENABLED=false
APP_DEMO_STUDENT_PASSWORD=Student123!
